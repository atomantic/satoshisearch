# --- satoshisearch configuration ---
# Copy to .env for local dev. In Umbrel these come from exports.sh / compose env.

# Mempool/esplora REST API base. Local dev points at the umbrel dev node.
# In Umbrel this is derived: http://$APP_MEMPOOL_IP:$APP_MEMPOOL_PORT
# Prefer Settings UI (saves to data/settings.json) — these are just the fallback.
MEMPOOL_API_URL=http://100.104.209.94:3006

# SQLite database + vault location
DATA_DIR=./data

# Max concurrent requests to the node (measured sweet spot ~8)
# Prefer Settings UI.
MEMPOOL_CONCURRENCY=8

# --- Network access ---
# Dev (npm run dev): access over Tailscale works out of the box — any *.ts.net
# host is allowed. Add other hostnames with ALLOWED_HOSTS (comma-separated).
ALLOWED_HOSTS=

# Prod (npm run build && npm start, i.e. adapter-node): form POSTs are CSRF-checked
# against the request origin. Over plain HTTP the server can't infer the scheme,
# so set ORIGIN to the exact URL you browse to. Not needed in dev.
#   Direct HTTP over Tailscale:  ORIGIN=http://<machine>.<tailnet>.ts.net:3117
#   Behind `tailscale serve` (HTTPS): leave ORIGIN empty and set
#   PROTOCOL_HEADER=x-forwarded-proto instead (Tailscale sets it).
ORIGIN=
PROTOCOL_HEADER=

# How far to index early coinbase outputs (block height, inclusive)
# Prefer Settings UI.
COINBASE_MAX_HEIGHT=50000

# --- Richlist / grinder match-set ---
# All settable in Settings UI. Minimum balance (sats) when fetching/importing a
# balance snapshot. Default 1 BTC.
RICHLIST_MIN_SATS=100000000
# Script types kept in the single-key match-set (comma-separated).
RICHLIST_SCRIPT_POLICY=p2pk,p2pkh,p2wpkh
# Daily funded-address dump (bootstrap). Prefer Core UTXO dump when RPC is wired.
RICHLIST_LOYCE_URL=http://addresses.loyce.club/blockchair_bitcoin_addresses_and_balance_LATEST.tsv.gz

# Bitcoin Core RPC — optional env fallback. Prefer Settings UI (saves to data/settings.json).
# Umbrel UI :2100 is not RPC; use :8332 (or your bind).
# BITCOIN_RPC_URL=http://100.104.209.94:8332
# BITCOIN_RPC_USER=
# BITCOIN_RPC_PASSWORD=
# BITCOIN_RPC_COOKIE=

# Fulcrum Electrum — also settable in Settings UI. Umbrel UI :2109 is not the API.
# FULCRUM_HOST=100.104.209.94
# FULCRUM_PORT=50002

# --- Rescue / sweep ---
# All settable in Settings UI (destination address can also be generated there
# as a brand-new wallet — the seed phrase is shown once and never stored).
#
# Destination address for swept funds. If UNSET, the app HOLDS and alerts
# instead of sweeping — there is nowhere safe to send to (fail-safe).
RESCUE_DEST_ADDRESS=

# 32-byte hex key that encrypts recovered private keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or click "Generate vault key" in Settings (only works while unset — rotating
# an existing key would orphan already-encrypted recovered keys, so that has
# to be a deliberate manual step, not a UI toggle).
# NEVER commit this. In Umbrel, store as an app secret.
VAULT_KEY_HEX=

# Global kill switch for any on-chain broadcast. "true" = never broadcast.
# Prefer Settings UI.
SWEEP_DRY_RUN=true

# Do not sweep outputs whose value is below this many sats (fee floor).
# Prefer Settings UI.
SWEEP_DUST_SATS=10000

# Per-bucket auto-sweep policy. Comma-separated list of classifications that
# may be swept automatically. Any hit NOT in this list is held + alerted only,
# regardless of balance (a human must approve the sweep in the UI).
# Prefer Settings UI.
#
# Buckets: puzzle | coinbase | dormant | richlist | coldcard | brainwallet | constants | lowentropy
#
# DEFAULT = puzzle only. The puzzle addresses are the single class explicitly
# designed to be swept; every other class may hold a living person's funds, so
# sweeping them without review is a legal/ethical grey area (see docs/RESCUE-POLICY.md).
SWEEP_AUTO_BUCKETS=puzzle

# White-hat attestation. Auto-sweeping any NON-puzzle bucket is refused unless
# the operator attests, here, that they are running a legitimate, authorized
# search-and-rescue operation and will return funds to their rightful owners.
# Set to the exact string below to attest. Puzzle sweeping never requires this.
# Prefer Settings UI (same exact-match requirement applies there).
#   I attest this is an authorized white-hat rescue and funds will be returned to their owners
RESCUE_WHITEHAT_ATTESTATION=

# --- Grinder pace (optional; Settings UI preferred) ---
# light | normal | full — light = overnight-friendly (few workers + throttle)
# GRIND_PACE=light
# GRIND_MAX_WORKERS=2
# GRIND_THROTTLE_MS=150

# --- Kangaroo (exposed-puzzle ECDLP) ---
# Prefer Settings UI. cpu = satoshi-kangaroo; jlp = JeanLucPons CUDA; external = JSONL cmd.
# KANGAROO_BACKEND=cpu
# KANGAROO_JLP_BIN=/opt/Kangaroo/kangaroo
# KANGAROO_JLP_GPU=1
# KANGAROO_JLP_GPU_ID=0
# KANGAROO_JLP_EXTRA=-d 18 -ws -w /data/kang.work -wi 300
# KANGAROO_EXTERNAL_CMD=./scripts/my-wrapper.sh {pubkey} {lo} {hi}
# See scripts/kangaroo-jlp-example.env and docs/KEYSPACE.md

# --- Realtime rescue runner notifications (optional) ---
# POST JSON on hit / runner lifecycle. See docs/RESCUE-RUNNER.md.
# RESCUE_WEBHOOK_URL=https://hooks.example/rescue
# Append one JSON object per line:
# RESCUE_NOTIFY_FILE=./data/rescue-hits.jsonl
# Advanced: shell with RESCUE_NOTIFY_JSON in the environment
# RESCUE_NOTIFY_CMD=./scripts/notify-slack.sh
