# Example env for an RTX 3090 Linux box running JeanLucPons Kangaroo.
# Copy into .env (or export) on the machine that has the GPU + CUDA binary.
#
# Build JLP (on that machine):
#   git clone https://github.com/JeanLucPons/Kangaroo.git
#   cd Kangaroo
#   # edit makefile CUDA path if needed
#   make gpu=1 ccap=86 all    # 3090 = compute capability 8.6
#
# Note: stock JLP is limited to ~125-bit intervals; use a maintained fork for
# larger exposed puzzles (#130+). RCKangaroo / forks often speak a similar
# file format — point KANGAROO_JLP_BIN at whatever binary you trust.

KANGAROO_BACKEND=jlp
KANGAROO_JLP_BIN=/opt/Kangaroo/kangaroo
KANGAROO_JLP_GPU=1
KANGAROO_JLP_GPU_ID=0
# Optional grid / DP / workfile flags passed through:
# KANGAROO_JLP_EXTRA=-d 18 -ws -w /data/kang.work -wi 300

# Then from satoshisearch:
#   npm run kangaroo -- --puzzle 125
# or start from the Grinder UI kangaroo card.
