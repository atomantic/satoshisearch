# Example env: run satoshisearch ON the GPU box (topology A).
# Full remote / SSH guide: docs/KANGAROO-GPU.md
#
# Build JLP (on that machine):
#   git clone https://github.com/JeanLucPons/Kangaroo.git && cd Kangaroo
#   make gpu=1 ccap=86 all    # 3090 = compute capability 8.6
#
# Stock JLP ≈ 125-bit interval limit; forks for larger ranges — see docs.

KANGAROO_BACKEND=jlp
KANGAROO_JLP_BIN=/opt/Kangaroo/kangaroo
KANGAROO_JLP_GPU=1
KANGAROO_JLP_GPU_ID=0
# KANGAROO_JLP_EXTRA=-d 18 -ws -w /data/kang.work -wi 300

# --- Topology B (app on observatory, GPU over SSH) — instead of jlp above: ---
# KANGAROO_BACKEND=external
# KANGAROO_EXTERNAL_CMD=scripts/kangaroo-ssh-wrapper.sh {pubkey} {lo} {hi}
# KANGAROO_SSH=user@gpu-box
# KANGAROO_JLP_REMOTE_BIN=/opt/Kangaroo/kangaroo
# KANGAROO_JLP_GPU_ID=0

# npm run kangaroo -- --puzzle 125

